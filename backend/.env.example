# Runtime configuration (validated at startup — TA §44; fail fast on missing required values)
NODE_ENV=development
PORT=8081
CORS_ORIGIN=http://localhost:5173

# Phase 2 (Firebase Admin — server-side):
FIREBASE_PROJECT_ID=demo-dev
# Local Emulator endpoints (uncomment for local development with emulators):
# FIRESTORE_EMULATOR_HOST=localhost:8082
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Phase 4 (Gemini — local dev only; production value comes from Secret Manager at runtime, never a file):
# GEMINI_API_KEY=
# AI_MODEL=gemini-3.6-flash
# Note: tsx watch does NOT auto-reload .env changes — restart the backend after editing this file.

# Phase 7 (Cloud Storage for Media):
# STORAGE_BUCKET=ai-scientific-journal-media
