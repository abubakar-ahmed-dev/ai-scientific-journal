# Runtime configuration (validated at startup — TA §44; fail fast on missing required values)
NODE_ENV=development
PORT=8081
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Firebase Local Emulators (Zero Cloud / No Google Account Required)
# Note: The 'demo-' prefix activates Firebase offline mode without cloud calls.
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=demo-test
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8082
# Storage emulator (firebase emulators:start --only storage). Without this the
# media routes target the real GCS bucket and fail without Application Default
# Credentials — signed URLs and uploads both 500.
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ------------------------------------------------------------------------------
# AI Service (Gemini vs Offline Fake AI — TESTING.md §13 seam)
# Set USE_FAKE_AI=true to serve AI responses from the built-in FakeAIService:
# no Gemini key, no network calls. "true"/"false" literals only.
# FORBIDDEN in production (startup fails fast on USE_FAKE_AI=true there).
# ------------------------------------------------------------------------------
USE_FAKE_AI=true
# GEMINI_API_KEY=   (unused when USE_FAKE_AI=true; required in production via Secret Manager)
AI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# Phase 7 (Cloud Storage for Media) — production value comes from Cloud Run env
# ------------------------------------------------------------------------------
# STORAGE_BUCKET=ai-scientific-journal-media
