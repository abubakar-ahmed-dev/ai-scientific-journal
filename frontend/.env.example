# ==============================================================================
# Frontend Local Environment (.env)
# ==============================================================================
# Backend API base (dev uses the Vite proxy — vite.config.ts forwards /api to
# localhost:8081; production is same-origin). No direct backend URL is needed.
VITE_API_BASE_URL=/api/v1

# ------------------------------------------------------------------------------
# Firebase Local Emulators (Zero Cloud / No Google Account Required)
# Note: The 'demo-' prefix activates Firebase offline mode without cloud calls.
# VITE_USE_FIREBASE_EMULATORS must be unset/empty in production builds.
# ------------------------------------------------------------------------------
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_AUTH_EMULATOR_HOST=http://localhost:9099
VITE_FIREBASE_PROJECT_ID=demo-test
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-test.firebaseapp.com
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
